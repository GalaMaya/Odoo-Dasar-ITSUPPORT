<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tampilan List (WAJIB pakai tag <list>, bukan <tree>) -->
    <record id="view_ticket_list" model="ir.ui.view">
        <field name="name">it.support.ticket.list</field>
        <field name="model">it.support.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="assigned_to"/>
                <field name="status"/>
                <field name="duration_hours"/>
            </list>
        </field>
    </record>

    <!-- Tampilan Form (Struktur Standar Odoo 18) -->
    <record id="view_ticket_form" model="ir.ui.view">
        <field name="name">it.support.ticket.form</field>
        <field name="model">it.support.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reopen" string="Buka Kembali" type="object" class="oe_highlight" invisible="status != 'done'"/>

                    <field name="status" widget="statusbar" statusbar_visible="draft, in_progress, done"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="assigned_to"/>
                        <field name="status"/>
                        <field name="duration_hours"/>
                        <field name="date_closed"/>
                        <field name="description"/>
                    </group>
                </sheet>
                
                <!-- Chatter diletakkan DI LUAR sheet, tapi DI DALAM form -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action (WAJIB pakai list,form) -->
    <record id="action_ticket" model="ir.actions.act_window">
        <field name="name">Ticket IT</field>
        <field name="res_model">it.support.ticket</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Utama -->
    <menuitem id="menu_ticket_root" name="IT Support"/>
    <menuitem id="menu_ticket" name="Ticket" parent="menu_ticket_root" action="action_ticket"/>

</odoo>