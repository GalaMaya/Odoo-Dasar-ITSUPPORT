<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_it_support_ticket_user" model="ir.rule">
        <field name="name">Staf IT: Hanya Tiket Sendiri</field>
        <field name="model_id" ref="model_it_support_ticket"/>
        <field name="domain_force">[('assigned_to', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_it_support_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_it_support_ticket_manager" model="ir.rule">
        <field name="name">Manager IT: Semua Tiket</field>
        <field name="model_id" ref="model_it_support_ticket"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_it_support_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>